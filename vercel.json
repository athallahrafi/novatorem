{
  "version": 2,
  "builds": [
    {
      "src": "api/orchestrator.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.11" }
    }
  ],
  "routes": [
    {
      "src": "/",
      "status": 301,
      "headers": { "Location": "https://github.com/athallahrafi" }
    },
    {
      "src": "/(.*)",
      "dest": "api/orchestrator.py"
    }
  ]
}
