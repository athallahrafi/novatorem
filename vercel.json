 {
  "redirects": [
    {
      "source": "/",
      "destination": "https://github.com/athallahrafi"
    }
  ],
  {
  "version": 2,
  "builds": [
    {
      "src": "api/orchestrator.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.11" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/orchestrator.py"
    }
  ]
}
}
